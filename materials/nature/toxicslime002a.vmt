// envmaptint_fix
"LightmappedGeneric"
{
	"LightmappedGeneric_DX6"
	{
		"$fallbackmaterial" "nature/toxicslime002a_dx70"
	}

	"$basetexture" "Nature/toxicslime002a"
	"$bumpmap" "Nature/xboxslime_normal"
	"$normalmapalphaenvmapmask" "1"
	"$surfaceprop" "slime"
	"$envmap" "env_cubemap"
	"$envmaptint" "[ 1.00 .89 .80 ]"
	"$envmapcontrast" "1"
	"%keywords" "wasteland"
	"%compileSlime" 1
	"$NODIFFUSEBUMPLIGHTING" "1"
	
	"$bottommaterial" "nature/toxicslime002a_beneath"
	
	"$fogenable" 1
	"$fogcolor" "{29 99 39}"
	"$fogstart" 1.00
	"$fogend" 100.00
	"Proxies"
	{
		//"AnimatedTexture"
		//{
			//"animatedtexturevar" "$bumpmap"
			//"animatedtextureframenumvar" "$bumpframe"
			//"animatedtextureframerate" 12.00
		//}
		"TextureScroll"
		{
			"texturescrollvar" "$bumptransform"
			"texturescrollrate" .01
			"texturescrollangle" 45.00
		}
	}
}



